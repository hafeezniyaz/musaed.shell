<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <WebView2UseWinRT>False</WebView2UseWinRT>
  </PropertyGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PackageIcon>Musaed Logo 64.png</PackageIcon>
    <ApplicationIcon>Resources\logo_256.ico</ApplicationIcon>
	  <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\background-rectangle.png" />
    <None Remove="Resources\background.png" />
    <None Remove="Resources\Logo 1024.ico" />
    <None Remove="Resources\logo 128.ico" />
    <None Remove="Resources\logo 16.ico" />
    <None Remove="Resources\Logo 512.ico" />
    <None Remove="Resources\logo-png.png" />
    <None Remove="Resources\logo-vector.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\background-rectangle.png" />
    <Resource Include="Resources\background.png" />
    <Resource Include="Resources\Logo 1024.ico" />
    <Resource Include="Resources\logo 128.ico" />
    <Resource Include="Resources\logo 16.ico" />
    <Resource Include="Resources\logo-png.png" />
    <Resource Include="Resources\logo-vector.png" />
    <Resource Include="Resources\logo_256.ico" />
    <Resource Include="Resources\logo_32.ico" />
    <Resource Include="Resources\Logo 512.ico" />
    <Resource Include="Resources\logo_64.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="9.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="9.0.8" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3405.78" />
    <PackageReference Include="Polly" Version="8.6.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Musaed.Core\Musaed.Core.csproj" />
    <ProjectReference Include="..\Musaed.Infrastructure\Musaed.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>



</Project>
